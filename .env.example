# Generate a long random value, for example: openssl rand -hex 32
BUILDABLE_SESSION_SECRET=replace-with-a-long-random-secret
# Required only on the first startup; it is hashed into /data/buildable.db.
BUILDABLE_INITIAL_PASSWORD=choose-a-shared-password
# Optional: enables targeted Rebrickable lookup. ZIP and manual import work without it.
BUILDABLE_REBRICKABLE_API_KEY=
# Set true when serving the app through HTTPS.
BUILDABLE_SECURE_COOKIES=false
# LAN host port (container port remains 8000).
BUILDABLE_PORT=8000
