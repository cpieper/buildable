# Generate a long random value, for example: openssl rand -hex 32
WHAT2BUILD_SESSION_SECRET=replace-with-a-long-random-secret
# Required only on the first startup; it is hashed into /data/what2build.db.
WHAT2BUILD_INITIAL_PASSWORD=choose-a-shared-password
# Optional: enables targeted Rebrickable lookup. ZIP and manual import work without it.
WHAT2BUILD_REBRICKABLE_API_KEY=
# Set true when serving the app through HTTPS.
WHAT2BUILD_SECURE_COOKIES=false
# LAN host port (container port remains 8000).
WHAT2BUILD_PORT=8000
